# EDUCATIONAL SECURITY TRAINING ENVIRONMENT
# Copy to .env and configure with secure random values

# =============================================================================
# SECURITY WARNING
# =============================================================================
# Generate new secure random values for all secrets!
# NEVER use these example values in any deployment!
# python3 -c "import secrets; print(secrets.token_hex(32))"

# =============================================================================
# Flask Application
# =============================================================================
FLASK_APP=app
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY_HERE
DEBUG=false

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
POSTGRES_DB=marketplace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database connection URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database encryption key (for pgcrypto)
DB_ENCRYPTION_KEY=CHANGE_ME_GENERATE_SECURE_ENCRYPTION_KEY

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_TYPE=redis
SESSION_PERMANENT=false
SESSION_USE_SIGNER=true
SESSION_COOKIE_NAME=marketplace_session
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# =============================================================================
# Security Configuration
# =============================================================================

# Rate Limiting (requests per time period)
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1

# Rate limits (format: "X per Y" where Y is second/minute/hour/day)
RATELIMIT_DEFAULT=10 per second
RATELIMIT_LOGIN=1 per minute
RATELIMIT_REGISTER=1 per hour
RATELIMIT_API=100 per minute

# CSRF Protection
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
BCRYPT_LOG_ROUNDS=12

# Session Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900

# =============================================================================
# Application Configuration
# =============================================================================

# Application URL (for Tor hidden service, update after generation)
APP_URL=http://localhost:8080
ONION_URL=http://GENERATED_ONION_ADDRESS.onion

# Upload Configuration
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=/app/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif
MAX_IMAGE_SIZE=2097152

# Escrow Configuration
ESCROW_AUTO_RELEASE_DAYS=14
ESCROW_COMMISSION_PERCENT=3.0
ESCROW_DISPUTE_WINDOW_DAYS=7

# Messaging
MESSAGE_RETENTION_DAYS=30
MESSAGE_MAX_LENGTH=5000
REQUIRE_PGP_ENCRYPTION=true

# =============================================================================
# Celery (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/3
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC

# =============================================================================
# Monitoring Configuration
# =============================================================================

# File Integrity Monitoring
FIM_ENABLED=true
FIM_CHECK_INTERVAL=3600
FIM_BASELINE_PATH=/app/monitoring/baseline.json
FIM_ALERT_ON_CHANGE=true

# Security Monitoring
MONITOR_ENABLED=true
MONITOR_CHECK_INTERVAL=300
MONITOR_ALERT_EMAIL=admin@localhost

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=INFO

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_GENERATE_SECURE_PASSPHRASE
BACKUP_PATH=/backups

# =============================================================================
# Tor Configuration
# =============================================================================
TOR_ENABLED=true
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=CHANGE_ME_GENERATE_TOR_PASSWORD

# =============================================================================
# Email Configuration (Optional - for alerts)
# =============================================================================
MAIL_ENABLED=false
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@marketplace.local

# =============================================================================
# Admin Configuration
# =============================================================================
ADMIN_EMAIL=admin@localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Dead Man's Switch
DEADMAN_ENABLED=false
DEADMAN_CHECKIN_INTERVAL=86400
DEADMAN_GRACE_PERIOD=172800

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/marketplace/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# =============================================================================
# Development / Debug (NEVER enable in production-like environments)
# =============================================================================
FLASK_DEBUG=false
SQLALCHEMY_ECHO=false
WERKZEUG_DEBUG_PIN=off

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_REGISTRATION=true
ENABLE_VENDOR_REGISTRATION=true
ENABLE_2FA=true
ENABLE_PGP_MESSAGING=true
ENABLE_ESCROW=true
ENABLE_REVIEWS=true

# =============================================================================
# Legal / Compliance
# =============================================================================
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
REQUIRE_TERMS_ACCEPTANCE=true
DATA_RETENTION_DAYS=365
GDPR_COMPLIANCE_MODE=true

# =============================================================================
# Performance Tuning
# =============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=5

SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600

REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Nginx Configuration
# =============================================================================
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=5m
NGINX_KEEPALIVE_TIMEOUT=65
